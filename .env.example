# ──────────────────────────────────────────────────────────────
# Health Harmony — frontend environment
# Copy to .env and fill with your project values.
#
# The Vite-prefixed (VITE_) values below are PUBLIC by design:
# the URL + Anon key are safe for browsers with RLS enabled.
#
# NEVER put the service-role key or provider secret keys here.
# Server-side secrets belong to Edge Functions only
# (see supabase/functions/orders-create/index.ts and its .env).
# ──────────────────────────────────────────────────────────────

# Supabase project (leave empty to run the site in DEMO mode
# with a bundled local catalog + demo auth).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional UI defaults (SAR is the platform default currency).
VITE_DEFAULT_CURRENCY=SAR
